# ==========================================
# 运行时环境变量覆盖 (Runtime Overrides)
# ==========================================

# 1. 基础环境标记 (覆盖 config.yml)
ENV=local
# LOG_LEVEL=debug # 取消注释以覆盖默认的 info 级别

# 2. 数据库机密 (用于初始化 Postgres 镜像 & Go 客户端连接)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=projecttemp_db

# 3. Redis 机密 (用于初始化 Redis 镜像 & Go 客户端连接)
REDIS_PASSWORD=

# 4. Session（对应 config.yml session.*，经 APP_ 前缀注入）
# APP_SESSION_SECRET=replace-with-long-random-string
# APP_SESSION_MAX_AGE=604800
# APP_SESSION_SECURE=true
